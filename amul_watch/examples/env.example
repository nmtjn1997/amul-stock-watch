# amul-watch secrets, KEY=value, one per line. Referenced from notifications.yaml as ${KEY}.
# This file is created with owner-only permissions. Never commit it.

# SMTP_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# DISCORD_WEBHOOK_URL=

# Optional web UI password (required if the UI is reachable from other machines)
# AMUL_WATCH_UI_PASSWORD=

# Optional: a browser cookie, only if the automatic session is blocked on your network.
# Set it with `amul-watch session import` rather than by hand.
# AMUL_COOKIE=
